{
  "name": "sunstar-content-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "export:static": "node scripts/export-static.mjs github",
    "export:vercel": "node scripts/export-static.mjs vercel",
    "start": "vinext start",
    "sync:naver": "node scripts/sync-naver.mjs",
    "build:localized-index": "node scripts/merge-localized-post-parts.mjs",
    "build:translation-manifests": "node scripts/build-translation-manifests.mjs",
    "validate:posts": "node scripts/validate-posts.mjs",
    "verify:production-sync": "node scripts/verify-production-sync.mjs",
    "verify:localized-production": "node scripts/verify-localized-production.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:static": "npm run export:static && node --test tests/static-export.test.mjs",
    "test:vercel": "npm run export:vercel && node --test tests/vercel-export.test.mjs tests/multilingual-export.test.mjs tests/site-analytics.test.mjs tests/kakao-adfit.test.mjs tests/sponsor-banner.test.mjs",
    "test:translations": "node --test tests/translation-manifests.test.mjs tests/localized-post-index.test.mjs",
    "test:sync": "node --test tests/naver-detail-extractor.test.mjs",
    "test:release": "npm run test:translations && npm run test:sync && npm run test:vercel && npm run lint",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern docs --ignore-pattern vercel-dist",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
